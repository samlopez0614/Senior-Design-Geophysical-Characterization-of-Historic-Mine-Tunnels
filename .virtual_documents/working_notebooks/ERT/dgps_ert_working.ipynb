def calculate_apparent_resistivity(ert):

    ert = ert.copy()


    def r(x1, z1, x2, z2):

        return np.sqrt(
            (x1 - x2)**2
            +
            (z1 - z2)**2
        )


    r_AM = r(
        ert["A_x"],
        ert["A_z"],
        ert["M_x"],
        ert["M_z"]
    )

    r_AN = r(
        ert["A_x"],
        ert["A_z"],
        ert["N_x"],
        ert["N_z"]
    )

    r_BM = r(
        ert["B_x"],
        ert["B_z"],
        ert["M_x"],
        ert["M_z"]
    )

    r_BN = r(
        ert["B_x"],
        ert["B_z"],
        ert["N_x"],
        ert["N_z"]
    )


    denominator = (
        1 / r_AM
        - 1 / r_AN
        - 1 / r_BM
        + 1 / r_BN
    )


    ert["K"] = (
        2 * np.pi
        /
        denominator
    )


    ert["apparent_resistivity"] = (
        ert["K"]
        *
        ert["resistance"]
    )


    # Horizontal center of measurement

    AB_mid = (
        ert["A_x"]
        +
        ert["B_x"]
    ) / 2


    MN_mid = (
        ert["M_x"]
        +
        ert["N_x"]
    ) / 2


    ert["distance_m"] = (
        AB_mid
        +
        MN_mid
    ) / 2


    # Approximate pseudodepth

    ert["pseudo_depth_m"] = (
        np.abs(
            AB_mid
            -
            MN_mid
        )
        / 2
    )


    return ert


